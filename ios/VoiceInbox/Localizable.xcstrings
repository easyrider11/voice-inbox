          "stringUnit": {
            "state": "translated",
            "value": "逾期"
          }
        }
      }
    },
    "Phone and Mac must be on the same Wi-Fi. Simulator: 127.0.0.1; device: your Mac's Bonjour name or LAN address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机与 Mac 需在同一 Wi-Fi。模拟器用 127.0.0.1，真机填 Mac 的局域网地址。"
          }
        }
      }
    },
