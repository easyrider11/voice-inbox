    "No ideas yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有想法"
          }
        }
      }
    },
    "No microphone access. Allow it for Voice Inbox in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风权限。请在设置中允许 Voice Inbox 使用麦克风。"
          }
        }
      }
    },
    "No reminders due today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没有到期的提醒"
