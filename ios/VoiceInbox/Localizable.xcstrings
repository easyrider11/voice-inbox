        }
      }
    },
    "On-device speech recognition isn't available right now (check the language pack, or try again).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机语音识别当前不可用（检查系统语言包或稍后重试）。"
          }
        }
      }
    },
    "Open Settings to check the address →": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置检查地址 →"
          }
