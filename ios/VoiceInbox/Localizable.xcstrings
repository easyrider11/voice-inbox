{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "AI sorts it out": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 自动整理"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Add Point": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加要点"
          }
        }
      }
    },
    "Add Subtask": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加子任务"
          }
        }
      }
    },
    "Applies to both on-device recognition and the server. Chinese and English are both supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时作用于本机识别和服务器。中文和英文都支持。"
          }
        }
      }
    },
    "Audio passes through the server only while being transcribed, then it's deleted. Results live only on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音只在转写期间经过服务器，处理完即删；结果只存在这台设备上"
          }
        }
      }
    },
    "Audio passes through your server only while being transcribed and is deleted right after. Results are stored only on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音只在处理期间经你的服务器转写，处理完即删；整理结果只保存在这台设备上。"
          }
        }
      }
    },
    "Can't reach the server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上服务器"
          }
        }
      }
    },
    "Can't reach the server. Open Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上服务器，打开设置"
          }
        }
      }
    },
    "Can't record": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法录音"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancel recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消录音"
          }
        }
      }
    },
    "Capture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记一条"
          }
        }
      }
