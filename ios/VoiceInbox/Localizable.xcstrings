      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这条捕捉？录音和转写将一并删除。"
          }
        }
      }
    },
    "Delete this card?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这张卡片？"
          }
        }
      }
    },
    "Delete this recording? The audio will be deleted too.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这条录音？音频将一并删除。"
          }
        }
      }
    },
    "Didn't catch that. Try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没听清内容，再说一次。"
