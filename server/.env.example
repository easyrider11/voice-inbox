# Voice Inbox server configuration. Copy to .env — never commit .env.

PORT=8787

# M2+ — Postgres (docker compose up -d starts a local one)
# DATABASE_URL=postgres://voiceinbox:voiceinbox@localhost:5432/voiceinbox

# M2+ — S3-compatible temp audio storage (local MinIO via docker compose)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=voice-inbox-audio
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# M2+ — AI providers (backend only; keys never ship in the client)
# ANTHROPIC_API_KEY=
# ASR_API_KEY=
