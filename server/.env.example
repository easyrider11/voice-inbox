# Voice Inbox server configuration. Copy to .env — never commit .env.

PORT=8787

# M2+ — Postgres (docker compose up -d starts a local one)
# DATABASE_URL=postgres://voiceinbox:voiceinbox@localhost:5432/voiceinbox

# M2+ — S3-compatible temp audio storage (local MinIO via docker compose)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=voice-inbox-audio
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# AI providers (backend only; keys never ship in the client).
# Each provider activates automatically when its credentials are set;
# otherwise a mock provider keeps the pipeline runnable for development.

# Claude — classification, structuring, meeting summaries
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Tencent Cloud ASR (一句话识别; the commercial engine family behind WeChat voice input).
# Get keys at console.cloud.tencent.com → 访问管理 → API密钥管理, and enable 语音识别.
# Engine 16k_zh-PY handles Mandarin + English + Cantonese code-switching.
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_ASR_ENGINE=16k_zh-PY
